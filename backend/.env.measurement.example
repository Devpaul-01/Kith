# backend/.env.measurement.example
#
# Points the app at the native local-test-stack (see
# scripts/local-test-stack/start.sh and scripts/MEASUREMENT_README.md)
# instead of a hosted Supabase project. Copy to .env before running any
# of the experiments under scripts/experiments/.
#
#   cp .env.measurement.example .env.measurement
#   cp .env.measurement .env
#   bash scripts/local-test-stack/start.sh
#
# JWT_SECRET here must match the jwt-secret configured for PostgREST
# in start.sh (test-jwt-secret-at-least-32-characters-long). The
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY values must be real
# JWTs signed with that same secret (role: "postgres") — start.sh does
# not mint these for you; see scripts/MEASUREMENT_README.md.

NODE_ENV=test
PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# pgrst-proxy.js, in front of bare PostgREST, strips the /rest/v1
# prefix so supabase-js (which always calls ${SUPABASE_URL}/rest/v1/...)
# works unmodified against a local, non-hosted PostgREST instance.
SUPABASE_URL=http://localhost:3001
SUPABASE_ANON_KEY=replace-with-a-jwt-signed-with-jwt-secret-below
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-jwt-signed-with-jwt-secret-below

JWT_SECRET=test-jwt-secret-at-least-32-characters-long

DATABASE_URL=postgresql://postgres:test@localhost:5432/kith_test

STORAGE_BUCKET_NAME=kith-files

REDIS_URL=redis://localhost:6379
