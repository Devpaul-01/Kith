{
  "name": "kith-backend",
  "version": "1.0.0",
  "description": "Kith — Family Coordination Platform Backend API",
  "main": "src/start-all.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:ratelimit": "jest --selectProjects rate-limit",
    "test:docker:up": "docker compose -f docker-compose.test.yml up -d",
    "test:docker:down": "docker compose -f docker-compose.test.yml down -v",
    "test:docker:seed": "PGPASSWORD=test psql -h localhost -p 54322 -U postgres -d kith_test -f migrations/001_schema.sql",
    "start": "node src/start-all.js",
    "dev": "nodemon src/start-all.js",
    "worker": "node src/workers/index.js",
    "scheduler": "node src/queues/scheduler.js",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@bull-board/api": "^5.14.3",
    "@bull-board/express": "^5.14.3",
    "@sentry/node": "^7.99.0",
    "@supabase/supabase-js": "2.45.4",
    "bullmq": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-stringify": "^6.4.6",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "rate-limit-redis": "^4.0.0",
    "resend": "^3.1.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ioredis-mock": "^8.9.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "setupFilesAfterEnv": ["<rootDir>/tests/setup.unit.js"],
        "testMatch": ["<rootDir>/tests/unit/**/*.test.js"]
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "setupFilesAfterEnv": ["<rootDir>/tests/setup.integration.js"],
        "testMatch": ["<rootDir>/tests/integration/**/*.test.js"]
        
      },
      {
        "displayName": "rate-limit",
        "testEnvironment": "node",
        "setupFilesAfterEnv": ["<rootDir>/tests/setup.ratelimit.js"],
        "testMatch": ["<rootDir>/tests/integration/redis/rate-limiting.test.js"]
        
      }
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
